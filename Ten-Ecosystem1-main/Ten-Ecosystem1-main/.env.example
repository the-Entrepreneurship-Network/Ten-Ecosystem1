# ─────────────────────────────────────────────────────────────────────────────
# TEN Ecosystem — environment configuration
#
# Copy to .env and fill in. NEVER commit .env.
# In production (NODE_ENV=production) the app refuses to boot if any secret
# marked REQUIRED is missing or too short — see config/secrets.js.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
BASE_URL=https://your-domain.example

# ── Core ─────────────────────────────────────────────────────────────────────
MONGODB_URI=

# ── REQUIRED security secrets ────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
SESSION_SECRET=          # REQUIRED, min 32 chars — signs session cookies
ADMIN_API_SECRET=        # REQUIRED, min 24 chars — x-admin-secret header value

# Admin portal login. Store a BCRYPT HASH, never a cleartext password:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" 'your-password'
# Without this the admin portal is closed — there is no default password.
ADMIN_USERNAME=tenadmin
ADMIN_PASSWORD_HASH=     # REQUIRED in production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated exact origins. Required in production; empty = allow all in dev only.
CORS_ALLOWED_ORIGINS=https://your-domain.example

# ── HR / coordinator accounts (REQUIRED in production) ───────────────────────
# There are no passwords in the source tree any more. server.js holds only a
# non-secret roster (display name, email, seniority level for HR; assigned
# domain for coordinators); every password comes from these two variables as a
# BCRYPT HASH. An account with no entry here simply cannot log in.
#
# Generate the value — never hand-write it:
#   1. echo '{"jrhr@ten.com":"the-password","vp@ten.com":"..."}' > /tmp/hr.json
#   2. node scripts/generate-credentials-env.js --in /tmp/hr.json --var HR_CREDENTIALS
#   3. paste the printed line here, then delete /tmp/hr.json
#
# Shape (metadata is optional and overrides the roster in server.js):
#   HR_CREDENTIALS={"jrhr@ten.com":{"passwordHash":"$2b$12$..."}}
#   COORDINATOR_CREDENTIALS={"python_admin":{"passwordHash":"$2b$12$..."}}
HR_CREDENTIALS=
COORDINATOR_CREDENTIALS=

# ── Payments ─────────────────────────────────────────────────────────────────
PAYMENTSETU_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Email (AWS SES SMTP) ─────────────────────────────────────────────────────
SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
EMAIL_FROM="TEN HR <hr@your-domain.example>"

# ── Optional integrations ────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Feature flags ────────────────────────────────────────────────────────────
# The Coding Problems section — Run Code, Submit, and the run console — is
# ENTIRELY off while this is false. Students can read a problem and write a
# solution, but nothing executes and nothing is graded.
#
# /code/run executes user-submitted source on the host. The child process now
# gets a scrubbed environment (it cannot read MONGODB_URI, SESSION_SECRET or the
# SMTP password out of process.env) and its own process group, needs a signed-in
# student session, and is rate-limited per account. That is containment, not a
# sandbox: a submitted program still shares the host's filesystem and network.
#
# Set to true to switch the coding section on. Prefer doing it only once the
# runner is inside a network-isolated, resource-capped container.
ENABLE_CODE_RUNNER=false

# ── Rate limits (optional overrides) ─────────────────────────────────────────
RATE_AUTH_WINDOW_MS=900000
RATE_AUTH_MAX=10
RATE_PUBLIC_MAX=100
RATE_AUTH_USER_MAX=300
RATE_PAYMENT_MAX=20

# Required by POST /api/v2/assistant/verify-payment.
# Without it, payment verification refuses with 503 and no tier can be granted.
ASSISTANT_ADMIN_TOKEN=

# ── Local JSON fallback database ─────────────────────────────────────────────
# Used only when MONGODB_URI is unset. Must stay OUTSIDE the public uploads/
# tree — it is a full copy of the user table, password hashes included.
LOCAL_DB_DIR=.data/local_db

# ── Star Performer contribution repository ───────────────────────────────────
# "owner/name". Submitted pull request URLs are validated against this.
GITHUB_OFFICIAL_REPO=the-Entrepreneurship-Network/Ten-Ecosystem1

# ── Web push notifications (optional) ────────────────────────────────────────
# Generate ONCE with: node scripts/generate-vapid-keys.js
# Then paste the output here. Until both are set, push notifications are simply
# off and everything else works exactly as before.
#
# VAPID_PUBLIC_KEY is handed to every browser that subscribes — it is not a
# secret. VAPID_PRIVATE_KEY is: it signs every notification this server sends,
# and anyone holding it can push notifications to your students' devices in
# your name. Never commit it.
#
# Regenerating the pair unsubscribes every device, because a browser binds its
# subscription to the public key it was created with. Generate once, keep them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real inbox the push services can use to reach you about this server.
VAPID_CONTACT=mailto:ten.hr.contact@gmail.com
