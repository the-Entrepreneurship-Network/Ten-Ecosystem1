{
  "name": "TEN Notifications",
  "short_name": "TEN Alerts",
  "description": "New messages and portal updates for The Entrepreneurship Network internship programme, in one place.",
  "id": "/notifications",
  "start_url": "/notifications",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#080d1a",
  "theme_color": "#0e1628",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "/icons/notif-192.png",          "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/notif-512.png",          "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/notif-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Unread only", "short_name": "Unread", "url": "/notifications?filter=unread",
      "icons": [{ "src": "/icons/notif-192.png", "sizes": "192x192" }] },
    { "name": "Messages", "short_name": "Messages", "url": "/messages",
      "icons": [{ "src": "/icons/notif-192.png", "sizes": "192x192" }] }
  ]
}
