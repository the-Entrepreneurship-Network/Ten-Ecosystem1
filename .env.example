# ── Core ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/<dbname>
PORT=5000

# ── Security ─────────────────────────────────────────────────────
# Secret used to authenticate admin API requests (e.g. GET /students)
ADMIN_API_SECRET=
# Comma-separated list of allowed CORS origins (e.g. https://yourdomain.com,https://admin.yourdomain.com)
CORS_ALLOWED_ORIGINS=

# ── Email ─────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── PaymentSetu ────────────────────────────────────────────────────
PAYMENTSETU_API_KEY=
# Base URL for redirect callbacks (e.g. https://yourdomain.com)
BASE_URL=

# ── HR Credentials (JSON map: {"username": "password", ...}) ──────
# Move hardcoded HR/Coordinator passwords here in production.
# Format: HR_CREDENTIALS={"hr_admin":"<secure-password>","hr_manager":"<secure-password>"}
# Format: COORDINATOR_CREDENTIALS={"devops_aws_admin":"<secure-password>",...}
HR_CREDENTIALS=
COORDINATOR_CREDENTIALS=

# ── GitHub Integration ────────────────────────────────────────────
# GitHub Personal Access Token to push/pull changes to the repository
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_AUTH_WINDOW_MS=900000        # 15 minutes in milliseconds
RATE_AUTH_MAX=10                  # Max attempts during the auth window
RATE_AUTH_BACKOFF_BASE=2          # Exponential backoff base factor (multiplier)
RATE_PUBLIC_WINDOW_MS=900000      # 15 minutes in milliseconds for public routes
RATE_PUBLIC_MAX=100               # Max requests during the public window
RATE_AUTH_USER_WINDOW_MS=900000   # 15 minutes for authenticated actions
RATE_AUTH_USER_MAX=300            # Max requests during the authenticated window
RATE_PAYMENT_WINDOW_MS=3600000    # 1 hour in milliseconds for payment routes
RATE_PAYMENT_MAX=20               # Max payment requests during the hour

